{
  "name": "@shadow-software/agt-sdk",
  "version": "0.2.1",
  "description": "TypeScript SDK for the American Gun Trader Dealer API",
  "homepage": "https://americanguntrader.com/docs/dealer-api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/smoke.test.mjs"
  },
  "keywords": [
    "american-gun-trader",
    "agt",
    "dealer-api",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow-software/agt-sdk.git"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
